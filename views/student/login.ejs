<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
    <title>Вход ученика — Мериты</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="chalkboard">
    <div>
        <h1 class="brand">MERIT</h1>
        <p class="brand-sub">Вход для учеников</p>

        <div class="paper-card">
            <p class="paper-card__title">Войти в аккаунт</p>

            <form id="loginForm">
                <div class="field">
                    <label for="classId">Класс</label>
                    <select id="classId" name="classId" required>
                        <% if (!classes || classes.length === 0) { %>
                            <option value="">Классы не найдены</option>
                        <% } else { %>
                            <option value="" selected disabled>Выбери класс</option>
                            <% classes.forEach(classItem => { %>
                                <option value="<%= classItem.id %>"><%= classItem.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="field">
                    <label for="journalNumber">Номер в журнале</label>
                    <input type="number" id="journalNumber" name="journalNumber" min="1" inputmode="numeric" required>
                </div>

                <div class="field">
                    <label for="pin">PIN-код</label>
                    <input type="password" id="pin" name="pin" maxlength="4" inputmode="numeric" pattern="[0-9]*" required>
                </div>

                <div class="field" style="margin-top:22px;margin-bottom:0;">
                    <button type="submit" class="btn btn-forest btn-block" id="submitBtn" <%= !classes || classes.length === 0 ? 'disabled' : '' %>>
                        Войти
                    </button>
                </div>

                <div id="errorMsg" class="error-msg"></div>
            </form>
        </div>
    </div>
</div>

<script>
const form = document.getElementById('loginForm');
const btn = document.getElementById('submitBtn');
const errorMsg = document.getElementById('errorMsg');

form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorMsg.textContent = '';
    btn.disabled = true;
    btn.textContent = 'Проверяем…';

    const data = Object.fromEntries(new FormData(form).entries());

    try {
        const response = await fetch('/student/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
            window.location.href = '/student/dashboard';
            return;
        }

        errorMsg.textContent = result.message || 'Не удалось войти';
        btn.disabled = false;
        btn.textContent = 'Войти';

    } catch (err) {
        errorMsg.textContent = 'Сервер недоступен, попробуй ещё раз';
        btn.disabled = false;
        btn.textContent = 'Войти';
    }
});
</script>
</body>
</html>
