<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1, maximum-scale=1"
    >
    <title><%= t('student.loginTitle') %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="auth-shell">

    <div class="auth-topline">
        <div class="app-logo">MERIT</div>

        <div class="language-switch">
            <a
                href="<%= languageUrl('ru') %>"
                class="<%= lang === 'ru' ? 'is-active' : '' %>"
            >
                RU
            </a>

            <a
                href="<%= languageUrl('en') %>"
                class="<%= lang === 'en' ? 'is-active' : '' %>"
            >
                EN
            </a>
        </div>
    </div>


    <main class="auth-main">

        <section class="auth-intro">
            <span class="auth-kicker">
                <%= t('student.loginSubtitle') %>
            </span>

            <h1>
                <%= t('student.loginCard') %>
            </h1>
        </section>


        <section class="auth-card">

            <form id="loginForm">

                <div class="field">

                    <label for="classId">
                        <%= t('common.class') %>
                    </label>

                    <select
                        id="classId"
                        name="classId"
                        required
                    >

                        <% if (!classes || classes.length === 0) { %>

                            <option value="">
                                <%= t('student.noClasses') %>
                            </option>

                        <% } else { %>

                            <option
                                value=""
                                selected
                                disabled
                            >
                                <%= t('student.chooseClass') %>
                            </option>

                            <% classes.forEach(classItem => { %>

                                <option value="<%= classItem.id %>">
                                    <%= classItem.name %>
                                </option>

                            <% }) %>

                        <% } %>

                    </select>

                </div>


                <div class="field">

                    <label for="journalNumber">
                        <%= t('student.journalNumber') %>
                    </label>

                    <input
                        type="number"
                        id="journalNumber"
                        name="journalNumber"
                        min="1"
                        inputmode="numeric"
                        required
                    >

                </div>


                <div class="field">

                    <label for="pin">
                        <%= t('student.pin') %>
                    </label>

                    <input
                        type="password"
                        id="pin"
                        name="pin"
                        maxlength="4"
                        inputmode="numeric"
                        pattern="[0-9]*"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn btn-primary btn-block"
                    id="submitBtn"
                    <%= !classes || classes.length === 0 ? 'disabled' : '' %>
                >
                    <%= t('student.login') %>
                </button>


                <div
                    id="errorMsg"
                    class="form-message form-message--error"
                    aria-live="polite"
                ></div>

            </form>

        </section>

    </main>

</div>


<script>
const form =
    document.getElementById(
        'loginForm'
    );

const button =
    document.getElementById(
        'submitBtn'
    );

const errorMessage =
    document.getElementById(
        'errorMsg'
    );

const labels = {
    login:
        <%- JSON.stringify(t('student.login')) %>,

    checking:
        <%- JSON.stringify(t('student.checking')) %>,

    failed:
        <%- JSON.stringify(t('student.loginFailed')) %>,

    unavailable:
        <%- JSON.stringify(t('common.unavailable')) %>
};


form.addEventListener(
    'submit',
    async event => {

        event.preventDefault();

        errorMessage.textContent =
            '';

        button.disabled =
            true;

        button.textContent =
            labels.checking;


        const data =
            Object.fromEntries(
                new FormData(form).entries()
            );


        try {

            const response =
                await fetch(
                    '/student/login',
                    {
                        method:
                            'POST',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(data)
                    }
                );


            const result =
                await response.json();


            if (result.success) {

                window.location.href =
                    '/student/dashboard';

                return;
            }


            errorMessage.textContent =
                result.message ||
                labels.failed;


        } catch (error) {

            console.error(error);

            errorMessage.textContent =
                labels.unavailable;

        } finally {

            if (
                window.location.pathname ===
                '/student'
            ) {
                button.disabled =
                    false;

                button.textContent =
                    labels.login;
            }

        }

    }
);
</script>

</body>
</html>
