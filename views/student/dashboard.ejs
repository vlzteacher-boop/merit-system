<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1, maximum-scale=1"
    >
    <title>MERIT</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="app-shell student-app">

    <header class="student-header">

        <a
            href="/student/dashboard"
            class="app-logo"
        >
            MERIT
        </a>


        <div class="student-header__right">

            <span class="student-header__name">
                <%= studentName %>
            </span>


            <span class="mini-balance">
                <strong id="topBalance">
                    <%= balance %>
                </strong>

                <span>
                    merit
                </span>
            </span>


            <div class="language-switch language-switch--dark">

                <a
                    href="<%= languageUrl('ru') %>"
                    class="<%= lang === 'ru' ? 'is-active' : '' %>"
                >
                    RU
                </a>

                <a
                    href="<%= languageUrl('en') %>"
                    class="<%= lang === 'en' ? 'is-active' : '' %>"
                >
                    EN
                </a>

            </div>


            <a
                href="/student/logout"
                class="logout-link"
            >
                <%= t('common.logout') %>
            </a>

        </div>

    </header>


    <main class="student-main">

        <section class="compact-summary">

            <div>

                <span class="summary-label">
                    <%= t('student.balanceLabel') %>
                </span>

                <strong class="summary-name">
                    <%= studentName %>
                </strong>

            </div>


            <div class="summary-balance">

                <span id="balanceDisplay">
                    <%= balance %>
                </span>

                <small>
                    merit
                </small>

            </div>

        </section>


        <section class="shop-section">

            <div class="section-heading">

                <div>
                    <span class="section-index">
                        01
                    </span>

                    <h2>
                        <%= t('student.shop') %>
                    </h2>
                </div>


                <p>
                    <%= rewards.length %>
                    <%= t('student.rewardsAvailable') %>
                </p>

            </div>


            <div
                id="shopMessage"
                class="purchase-message"
                aria-live="polite"
            ></div>


            <% if (!rewards || rewards.length === 0) { %>

                <div class="empty-panel">

                    <strong>
                        <%= t('student.noRewards') %>
                    </strong>

                    <span>
                        <%= t('student.noRewardsText') %>
                    </span>

                </div>

            <% } else { %>

                <div class="reward-grid">

                    <% rewards.forEach((reward, index) => { %>

                        <article class="reward-card">

                            <div class="reward-card__meta">

                                <span class="reward-number">
                                    <%= String(index + 1).padStart(2, '0') %>
                                </span>

                                <span class="reward-cost-pill">
                                    <%= reward.cost %> merit
                                </span>

                            </div>


                            <div class="reward-card__body">

                                <h3>
                                    <%= reward.title %>
                                </h3>


                                <% if (reward.description) { %>

                                    <p>
                                        <%= reward.description %>
                                    </p>

                                <% } %>

                            </div>


                            <div class="reward-card__footer">

                                <div class="reward-price">

                                    <strong>
                                        <%= reward.cost %>
                                    </strong>

                                    <span>
                                        merit
                                    </span>

                                </div>


                                <button
                                    type="button"
                                    class="reward-buy"
                                    data-reward-key="<%= reward.reward_key %>"
                                    data-reward-cost="<%= reward.cost %>"
                                    <%= balance < reward.cost ? 'disabled' : '' %>
                                >

                                    <span class="reward-buy__ready">
                                        <%= t('student.buy') %>
                                    </span>

                                    <span class="reward-buy__poor">
                                        <%= t(
                                            'student.needMore',
                                            {
                                                amount:
                                                    Math.max(
                                                        0,
                                                        reward.cost - balance
                                                    )
                                            }
                                        ) %>
                                    </span>

                                </button>

                            </div>

                        </article>

                    <% }) %>

                </div>

            <% } %>

        </section>


        <section class="orders-section">

            <div class="section-heading">

                <div>
                    <span class="section-index">
                        02
                    </span>

                    <h2>
                        <%= t('student.purchases') %>
                    </h2>
                </div>

            </div>


            <div
                id="ordersList"
                class="order-list"
            >

                <% if (!orders || orders.length === 0) { %>

                    <div
                        class="empty-panel"
                        id="ordersEmpty"
                    >

                        <strong>
                            <%= t('student.emptyPurchases') %>
                        </strong>

                        <span>
                            <%= t('student.emptyPurchasesText') %>
                        </span>

                    </div>

                <% } else { %>

                    <% orders.forEach(order => { %>

                        <article class="order-card">

                            <div class="order-card__main">

                                <span class="order-card__code">
                                    <%= order.code %>
                                </span>

                                <strong>
                                    <%= order.display_reward_title || order.reward_title || 'MERIT' %>
                                </strong>

                            </div>


                            <div class="order-card__aside">

                                <% if (order.reward_cost !== null && order.reward_cost !== undefined) { %>

                                    <span class="order-card__price">
                                        <%= order.reward_cost %> merit
                                    </span>

                                <% } %>


                                <span
                                    class="status status--<%= order.status %>"
                                >
                                    <%= t(`status.${order.status}`) %>
                                </span>

                            </div>

                        </article>

                    <% }) %>

                <% } %>

            </div>

        </section>

    </main>

</div>


<script>
let currentBalance =
    Number(
        <%- JSON.stringify(balance) %>
    );


const buttons =
    Array.from(
        document.querySelectorAll(
            '.reward-buy'
        )
    );


const shopMessage =
    document.getElementById(
        'shopMessage'
    );


const labels = {
    buy:
        <%- JSON.stringify(t('student.buy')) %>,

    needMoreTemplate:
        <%- JSON.stringify(t('student.needMore', { amount: '__AMOUNT__' })) %>,

    successTitle:
        <%- JSON.stringify(t('student.purchaseSuccessTitle')) %>,

    successTemplate:
        <%- JSON.stringify(t('student.purchaseSuccessText', {
            title: '__TITLE__',
            balance: '__BALANCE__'
        })) %>,

    failedTitle:
        <%- JSON.stringify(t('student.purchaseFailedTitle')) %>,

    failed:
        <%- JSON.stringify(t('student.purchaseFailed')) %>,

    unavailableTitle:
        <%- JSON.stringify(t('student.purchaseUnavailableTitle')) %>,

    unavailable:
        <%- JSON.stringify(t('common.unavailable')) %>,

    pending:
        <%- JSON.stringify(t('status.pending_print')) %>
};


function formatTemplate(
    template,
    replacements
) {

    let result =
        String(template);


    Object.entries(
        replacements
    ).forEach(
        ([key, value]) => {

            result =
                result.replaceAll(
                    `__${key}__`,
                    String(value)
                );

        }
    );


    return result;

}


function updateBalanceUI() {

    document
        .getElementById(
            'balanceDisplay'
        )
        .textContent =
            currentBalance;


    document
        .getElementById(
            'topBalance'
        )
        .textContent =
            currentBalance;


    buttons.forEach(
        button => {

            if (
                button.classList.contains(
                    'reward-buy--loading'
                )
            ) {
                return;
            }


            const cost =
                Number(
                    button.dataset.rewardCost
                );


            const canBuy =
                currentBalance >= cost;


            button.disabled =
                !canBuy;


            const ready =
                button.querySelector(
                    '.reward-buy__ready'
                );


            const poor =
                button.querySelector(
                    '.reward-buy__poor'
                );


            if (ready) {
                ready.textContent =
                    labels.buy;
            }


            if (poor) {

                poor.textContent =
                    formatTemplate(
                        labels.needMoreTemplate,
                        {
                            AMOUNT:
                                Math.max(
                                    0,
                                    cost - currentBalance
                                )
                        }
                    );

            }

        }
    );

}


function escapeHtml(value) {

    const node =
        document.createElement(
            'div'
        );


    node.textContent =
        String(value ?? '');


    return node.innerHTML;

}


function showMessage(
    type,
    title,
    text
) {

    shopMessage.className =
        `purchase-message purchase-message--${type}`;


    shopMessage.innerHTML = `
        <strong>
            ${escapeHtml(title)}
        </strong>

        <span>
            ${escapeHtml(text)}
        </span>
    `;


    shopMessage.scrollIntoView({
        behavior:
            'smooth',

        block:
            'nearest'
    });

}


function addOrderToList(result) {

    const list =
        document.getElementById(
            'ordersList'
        );


    const empty =
        document.getElementById(
            'ordersEmpty'
        );


    if (empty) {
        empty.remove();
    }


    const item =
        document.createElement(
            'article'
        );


    item.className =
        'order-card';


    item.innerHTML = `
        <div class="order-card__main">

            <span class="order-card__code">
                ${escapeHtml(result.orderCode)}
            </span>

            <strong>
                ${escapeHtml(result.reward.title)}
            </strong>

        </div>

        <div class="order-card__aside">

            <span class="order-card__price">
                ${Number(result.reward.cost)} merit
            </span>

            <span class="status status--pending_print">
                ${escapeHtml(labels.pending)}
            </span>

        </div>
    `;


    list.prepend(item);

}


buttons.forEach(
    button => {

        button.addEventListener(
            'click',
            async () => {

                if (button.disabled) {
                    return;
                }


                const rewardKey =
                    button.dataset.rewardKey;


                button.disabled =
                    true;


                button.classList.add(
                    'reward-buy--loading'
                );


                shopMessage.className =
                    'purchase-message';


                shopMessage.innerHTML =
                    '';


                try {

                    const response =
                        await fetch(
                            '/api/buy',
                            {
                                method:
                                    'POST',

                                headers: {
                                    'Content-Type':
                                        'application/json'
                                },

                                body:
                                    JSON.stringify({
                                        rewardKey
                                    })
                            }
                        );


                    const result =
                        await response.json();


                    if (!result.success) {

                        button.classList.remove(
                            'reward-buy--loading'
                        );


                        showMessage(
                            'error',
                            labels.failedTitle,
                            result.message ||
                            labels.failed
                        );


                        updateBalanceUI();

                        return;
                    }


                    currentBalance =
                        Number(
                            result.newBalance
                        );


                    button.classList.remove(
                        'reward-buy--loading'
                    );


                    addOrderToList(
                        result
                    );


                    updateBalanceUI();


                    showMessage(
                        'success',
                        labels.successTitle,
                        formatTemplate(
                            labels.successTemplate,
                            {
                                TITLE:
                                    result.reward.title,

                                BALANCE:
                                    currentBalance
                            }
                        )
                    );


                } catch (error) {

                    console.error(error);


                    button.classList.remove(
                        'reward-buy--loading'
                    );


                    showMessage(
                        'error',
                        labels.unavailableTitle,
                        labels.unavailable
                    );


                    updateBalanceUI();

                }

            }
        );

    }
);


updateBalanceUI();
</script>

</body>
</html>
