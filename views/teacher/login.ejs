<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Вход учителя — Мериты</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="chalkboard">
    <div>
        <h1 class="brand">MERIT</h1>
        <p class="brand-sub">Вход для учителя</p>

        <div class="paper-card">
            <p class="paper-card__title">Кабинет учителя</p>

            <form method="POST" action="/teacher/login">
                <div class="field">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required autofocus>
                </div>

                <div class="field">
                    <label for="password">Пароль</label>
                    <input type="password" id="password" name="password" required>
                </div>

                <div class="field" style="margin-top:22px;">
                    <button type="submit" class="btn btn-forest btn-block">Войти</button>
                </div>

                <% if (error) { %>
                    <div class="error-msg"><%= error %></div>
                <% } %>
            </form>
        </div>
    </div>
</div>
</body>
</html>
