<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >
    <title><%= t('teacher.dashboardTitle') %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="staff-shell">

    <header class="staff-header">

        <div>
            <div class="app-logo">
                MERIT
            </div>

            <span class="staff-role">
                <%= t('teacher.dashboardTitle') %>
            </span>
        </div>


        <div class="staff-header__actions">

            <span class="staff-name">
                <%= teacherName %>
            </span>


            <div class="language-switch language-switch--dark">

                <a
                    href="<%= languageUrl('ru') %>"
                    class="<%= lang === 'ru' ? 'is-active' : '' %>"
                >
                    RU
                </a>

                <a
                    href="<%= languageUrl('en') %>"
                    class="<%= lang === 'en' ? 'is-active' : '' %>"
                >
                    EN
                </a>

            </div>


            <a
                href="/teacher/logout"
                class="btn btn-secondary"
            >
                <%= t('common.logout') %>
            </a>

        </div>

    </header>


    <main class="staff-main">

        <% if (success) { %>

            <div class="staff-message staff-message--success">
                <%= success %>
            </div>

        <% } %>


        <section class="staff-toolbar">

            <form
                method="GET"
                action="/teacher/dashboard"
            >

                <div class="field field--compact">

                    <label for="classId">
                        <%= t('common.class') %>
                    </label>

                    <select
                        id="classId"
                        name="classId"
                        onchange="this.form.submit()"
                        <%= classes.length === 0 ? 'disabled' : '' %>
                    >

                        <% classes.forEach(classItem => { %>

                            <option
                                value="<%= classItem.id %>"
                                <%= Number(selectedClassId) === Number(classItem.id) ? 'selected' : '' %>
                            >
                                <%= classItem.name %>
                            </option>

                        <% }) %>

                    </select>

                </div>

            </form>

        </section>


        <section class="staff-card">

            <div class="staff-card__heading">

                <h1>
                    <%= t('teacher.students') %>
                </h1>

            </div>


            <% if (!students || students.length === 0) { %>

                <div class="empty-panel empty-panel--light">
                    <span>
                        <%= t('teacher.noStudents') %>
                    </span>
                </div>

            <% } else { %>

                <div class="table-scroll">

                    <table class="journal-table">

                        <thead>
                            <tr>
                                <th><%= t('common.number') %></th>
                                <th><%= t('common.student') %></th>
                                <th><%= t('common.balance') %></th>
                                <th><%= t('teacher.add') %></th>
                            </tr>
                        </thead>


                        <tbody>

                            <% students.forEach(student => { %>

                                <tr>

                                    <td class="journal-num">
                                        <%= student.journal_number %>
                                    </td>

                                    <td class="student-name">
                                        <%= student.full_name %>
                                    </td>

                                    <td>
                                        <span class="merit-badge">
                                            <%= student.balance %>
                                        </span>
                                    </td>

                                    <td>

                                        <form
                                            class="inline-form"
                                            method="POST"
                                            action="/teacher/add-merits"
                                        >

                                            <input
                                                type="hidden"
                                                name="userId"
                                                value="<%= student.id %>"
                                            >

                                            <input
                                                type="hidden"
                                                name="classId"
                                                value="<%= selectedClassId %>"
                                            >

                                            <input
                                                type="number"
                                                name="amount"
                                                placeholder="<%= t('teacher.amountPlaceholder') %>"
                                                min="1"
                                                step="1"
                                                required
                                            >

                                            <input
                                                type="text"
                                                name="reason"
                                                placeholder="<%= t('teacher.reasonPlaceholder') %>"
                                                maxlength="200"
                                                required
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-primary btn-small"
                                            >
                                                <%= t('teacher.add') %>
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

</div>

</body>
</html>
