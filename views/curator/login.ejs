<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >
    <title><%= t('curator.loginTitle') %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="auth-shell">

    <div class="auth-topline">

        <div class="app-logo">
            MERIT
        </div>


        <div class="language-switch">

            <a
                href="<%= languageUrl('ru') %>"
                class="<%= lang === 'ru' ? 'is-active' : '' %>"
            >
                RU
            </a>

            <a
                href="<%= languageUrl('en') %>"
                class="<%= lang === 'en' ? 'is-active' : '' %>"
            >
                EN
            </a>

        </div>

    </div>


    <main class="auth-main">

        <section class="auth-intro">

            <span class="auth-kicker">
                <%= t('curator.loginSubtitle') %>
            </span>

            <h1>
                <%= t('curator.loginCard') %>
            </h1>

        </section>


        <section class="auth-card">

            <form
                method="POST"
                action="/curator/login"
            >

                <div class="field">

                    <label for="email">
                        <%= t('curator.email') %>
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        autocomplete="username"
                        required
                        autofocus
                    >

                </div>


                <div class="field">

                    <label for="password">
                        <%= t('curator.password') %>
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        autocomplete="current-password"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn btn-primary btn-block"
                >
                    <%= t('curator.login') %>
                </button>


                <% if (error) { %>

                    <div class="form-message form-message--error">
                        <%= error %>
                    </div>

                <% } %>

            </form>

        </section>

    </main>

</div>

</body>
</html>
